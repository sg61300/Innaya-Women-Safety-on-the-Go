# VAIRA mobile public config (EXPO_PUBLIC_* is bundled into the app).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_PICOVOICE_KEY=
EXPO_PUBLIC_E2E=0
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
# Mixpanel client-side tracking (optional). Unset => no-op. Needs a new APK/build
# once the mixpanel-react-native SDK is installed (see Architecture/08).
EXPO_PUBLIC_MIXPANEL_TOKEN=
